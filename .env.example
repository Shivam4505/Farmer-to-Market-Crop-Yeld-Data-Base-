# ==============================================================================
# FARMER-TO-MARKET CROP YIELD & PRICING DATABASE
# Environment Configuration Template
# Copy this file to .env and configure with your local database credentials.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Oracle Database Configuration (Thin Mode / Instant Client)
ORACLE_USER=c##farmer_admin
ORACLE_PASSWORD=YourSecureOraclePasswordHere
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
# If using Oracle XE: localhost:1521/XEPDB1
# If using local standard listener: localhost:1521/XE

# MongoDB Configuration (Weather Document Store)
MONGO_URI=mongodb://localhost:27017/farmer_market_db
MONGO_WEATHER_COLLECTION=weather_logs

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_for_adbms_college_project_change_in_production
JWT_EXPIRES_IN=24h
